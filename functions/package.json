{
  "name": "fiveacross-functions",
  "description": "Cloud Functions for Gay Cruise Bingo (Phase 1): moderation and thumbnails (stats stay client-authoritative, ADR 0001).",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && cp src/bugReportContract.cjs lib/bugReportContract.cjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && op-firebase-deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.2.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
