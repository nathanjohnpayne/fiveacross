{
  "name": "gaycruisebingo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gay Cruise Bingo — live multiplayer bingo PWA (Phase 0).",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gaycruisebingo": "node scripts/build-target.mjs gaycruisebingo",
    "build:fiveacross": "node scripts/build-target.mjs fiveacross",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:offline": "firebase emulators:exec --only auth,firestore \"vitest run --config vitest.offline.config.ts\"",
    "test:functions": "npm --prefix functions install && vitest run --config vitest.functions.config.ts",
    "test:e2e": "scripts/test-e2e.sh",
    "test:synthetic": "playwright test --config playwright.synthetic.config.ts",
    "emulator": "firebase emulators:start --only auth,firestore,storage",
    "seed": "node scripts/seed.mjs",
    "verify:seed": "GOOGLE_CLOUD_PROJECT=gaycruisebingo VITE_EVENT_ID=med-2026 node scripts/seed.mjs --verify",
    "verify:seed:fiveacross": "GOOGLE_CLOUD_PROJECT=fiveacross VITE_EVENT_ID=bodega-bay-2026 node scripts/seed.mjs --verify",
    "provision:bodega-preview": "node scripts/provision-bodega-preview.mjs",
    "bugs:pull": "node scripts/bug-reports.mjs pull",
    "bugs:archive": "node scripts/bug-reports.mjs archive",
    "bugs:disposition": "node scripts/bug-reports.mjs disposition",
    "deploy": "node scripts/deploy-target.mjs",
    "deploy:hosting": "node scripts/deploy-target.mjs --hosting",
    "deploy:gaycruisebingo": "node scripts/deploy-target.mjs gaycruisebingo",
    "deploy:gaycruisebingo:hosting": "node scripts/deploy-target.mjs --hosting gaycruisebingo",
    "deploy:fiveacross": "node scripts/deploy-target.mjs fiveacross",
    "deploy:fiveacross:hosting": "node scripts/deploy-target.mjs --hosting fiveacross",
    "pretest:e2e": "playwright install chromium"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.29.0",
    "posthog-js": "^1.413.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^15.26.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "@hono/node-server": "^2.0.5"
  }
}
