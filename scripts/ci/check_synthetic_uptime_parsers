#!/usr/bin/env bash
set -euo pipefail

# check_synthetic_uptime_parsers
#
# Source-level assertions over `.github/workflows/synthetic-uptime.yml`
# (#768 Phase 4b, plus the #774 rollout-epoch anchor from Codex P2 on PR #827).
#
# These are gaycruisebingo-local: `synthetic-uptime.yml` exists only here, and
# canonical `scripts/ci/check_workflow_parsers` carries no counterpart. They
# used to live at the tail of the local copy of that file, which is the wrong
# home for them. `scripts/ci/` is a mergepath `type: kit, consumers: all`
# entry, so it is mirrored VERBATIM on every propagation wave. The next wave
# delivers the whole kit here for the first time (the `.sync-overrides.yml`
# skip was lifted 2026-08-18 once mergepath#911 landed), and that overwrite
# would have deleted all 71 lines silently: the propagation lane marker only
# proves the mirror byte-matches mergepath, which is exactly what a successful
# overwrite produces, and `wave-audit.sh` builds its diff from mergepath
# manifest source paths, so consumer-only lines sit outside that diff by
# construction. See mergepath#1055.
#
# Moving them into a consumer-only script fixes that structurally. A
# `scripts/ci/` file mergepath has never had is not in the sync target list,
# so the kit mirror leaves it alone (matchline has carried three such checks
# across several waves). It is wired from the never-propagated
# `.github/workflows/repo_lint_local.yml` annex (mergepath#601/#655), which
# `check_ci_scripts_wired` scans as a union with `repo_lint.yml`.
#
# The assertions are deliberately source-level: the GitHub Actions `run:` block
# owns the classifier, so copying it into a local helper would give the tests a
# second implementation that can drift.
#
# Exit 0 = pass. Exit 1 = at least one assertion failed.

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

for f in .github/workflows/synthetic-uptime.yml \
         tests/synthetic/unsubscribe-invoker.spec.ts \
         scripts/deploy.sh; do
  if [ ! -f "$f" ]; then
    echo "check_synthetic_uptime_parsers: missing required file: $f" >&2
    exit 1
  fi
done

pass=0
fail=0
echo
echo "synthetic-uptime.yml multi-surface classification (#768 Phase 4b)"
synthetic_uptime_workflow=".github/workflows/synthetic-uptime.yml"

# These are intentionally source-level assertions: the GitHub Actions `run:`
# block owns the classifier, so copying it into a local helper would give the
# tests a second implementation that can drift. Pin the ordering that prevents
# a simultaneous app-mount outage from being hidden behind the unsubscribe-403
# advice, and pin the title update on a reused tracking issue.
multi_surface_line=$(grep -nF 'if [[ "$failure_count" -gt 1 ]]; then' "$synthetic_uptime_workflow" | head -1 | cut -d: -f1 || true)
single_unsubscribe_line=$(grep -nF 'elif [[ "$unsubscribe_403" == "true" ]]; then' "$synthetic_uptime_workflow" | head -1 | cut -d: -f1 || true)
if [[ -n "$multi_surface_line" && -n "$single_unsubscribe_line" && "$multi_surface_line" -lt "$single_unsubscribe_line" ]] && \
   grep -Fq 'failure_count=$((failure_count + 1))' "$synthetic_uptime_workflow" && \
   grep -Fq 'app did not mount|Firebase init error|uncaught exception|sign-in gate never rendered' "$synthetic_uptime_workflow"; then
  pass=$((pass + 1))
  echo "  PASS: combined failures are classified before single-surface unsubscribe advice"
else
  fail=$((fail + 1))
  echo "  FAIL: synthetic uptime must classify combined app/unsubscribe failures before single-surface advice" >&2
fi

unsubscribe_probe="tests/synthetic/unsubscribe-invoker.spec.ts"
if grep -Fq 'emailUnsubscribe probe failed' "$unsubscribe_probe" && \
   grep -Fq 'emailUnsubscribe probe failed' "$synthetic_uptime_workflow" && \
   grep -Fq 'elif [[ "$unsubscribe_other" == "true" ]]; then' "$synthetic_uptime_workflow"; then
  pass=$((pass + 1))
  echo "  PASS: every non-400 unsubscribe response carries a classifier marker and endpoint-specific advice"
else
  fail=$((fail + 1))
  echo "  FAIL: synthetic uptime must not misclassify generic unsubscribe failures as app-mount failures" >&2
fi

if grep -Fq 'SYNTHETIC_DEPLOYMENT_CHECK=true' scripts/deploy.sh && \
   grep -Fq 'SYNTHETIC_DEPLOYMENT_CHECK' "$unsubscribe_probe" && \
   grep -Fq 'RAW_UNSUBSCRIBE_URL' "$unsubscribe_probe" && \
   grep -Fq 'UNSUBSCRIBE_REWRITE_GRACE_UNTIL' "$unsubscribe_probe" && \
   grep -Fq 'UNSUBSCRIBE_REWRITE_GRACE_UNTIL=$grace_until' "$synthetic_uptime_workflow" && \
   grep -Fq 'fetch-depth: 0' "$synthetic_uptime_workflow" && \
   ! grep -Fq 'ROLLOUT_ENFORCE_FROM' "$unsubscribe_probe"; then
  pass=$((pass + 1))
  echo "  PASS: deploy-time checks enforce Hosting while scheduled raw-IAM grace has a commit-derived expiry"
else
  fail=$((fail + 1))
  echo "  FAIL: unsubscribe grace must be deployment-contextual, raw-IAM-protected, and bounded by commit-derived state" >&2
fi

# #774 (Codex P2 on PR #827): the rollout-epoch lookup must anchor on
# first-parent history so a non-squash merge (allowed by this repo's GitHub
# settings — allow_merge_commit / allow_rebase_merge are both on, with no
# branch-protection squash-only enforcement) attributes the grace deadline to
# the MERGE itself, not a buried feature-branch commit that can predate it by
# more than the 72-hour window. A source-level assertion, like its siblings
# above: the workflow's `run:` block owns the actual lookup, so this pins the
# flag rather than re-implementing the lookup as a second source of truth.
if grep -Fq 'git log --first-parent --diff-filter=A' "$synthetic_uptime_workflow"; then
  pass=$((pass + 1))
  echo "  PASS: the rollout-epoch lookup anchors on first-parent history (#774)"
else
  fail=$((fail + 1))
  echo "  FAIL: the rollout-epoch lookup must use --first-parent so a non-squash merge attributes the grace deadline to the merge itself, not a buried feature-branch commit (#774)" >&2
fi

if grep -Fq 'gh issue edit "$existing" --repo "$GITHUB_REPOSITORY" \' "$synthetic_uptime_workflow" && \
   grep -Fq -- '--title "Synthetic uptime check failing: $subject"' "$synthetic_uptime_workflow"; then
  pass=$((pass + 1))
  echo "  PASS: an existing synthetic issue is retitled for the current failing surface"
else
  fail=$((fail + 1))
  echo "  FAIL: synthetic uptime must retitle an existing tracking issue from the current subject" >&2
fi

echo
if [ "$fail" -gt 0 ]; then
  echo "check_synthetic_uptime_parsers: $fail FAIL / $pass PASS" >&2
  exit 1
fi
echo "check_synthetic_uptime_parsers: PASS ($pass tests)"
