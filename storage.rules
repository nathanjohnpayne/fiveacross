rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isEventAdmin(eventId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/events/$(eventId)).data.admins;
    }
    // The Storage half of the post-Event freeze (#134,
    // specs/post-sailing-archive.md). `firestore.rules` denies the Proof
    // DOCUMENT on a closing or archived Event; this denies its MEDIA, because a
    // denial on only one of the two leaves an archive that still grows blobs —
    // the #806 lesson, and exactly what `specs/path-addressing-and-root.md` § D8
    // names ("Storage uploads under that Event's prefix alike").
    //
    // Both halves of the freeze deny here, exactly as they do in
    // `firestore.rules`: the CLOSING state (`archiving: true`) is the quiescing
    // phase the archive snapshot is taken during, so media that could still land
    // through it would be media the record never sees (Codex P1, PR #1139).
    //
    // Two Firestore accesses, which is the whole per-evaluation budget Storage
    // Rules allow — affordable only because the create/update arm below spends
    // none today. Reading the document ONCE and passing its data to
    // `closedToPlay` is what keeps it at two: unlike `firestore.rules`, Storage
    // Rules make no promise of deduplicating a repeated `firestore.get()` on the
    // same path, so a second inline read of the same document could spend the
    // budget and fail the upload closed. The `exists()` half is not decoration
    // either: without it a missing Event document would error the `get()` and
    // newly deny an upload that succeeds today, and the `'active'` / `false`
    // defaults keep an Event document carrying neither key OPEN. Deletes
    // deliberately keep their single `isEventAdmin()` access and are NOT gated:
    // an Admin must still be able to take media down out of a frozen record.
    function closedToPlay(event) {
      return event.get('status', 'active') == 'archived'
        || event.get('archiving', false) == true;
    }
    function eventClosedToPlay(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        && closedToPlay(firestore.get(/databases/(default)/documents/events/$(eventId)).data);
    }
    function okImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }
    function okAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 12 * 1024 * 1024;
    }

    // Custom avatars. uploadAvatar() writes avatars/{uid}.jpg, so the wildcard
    // captures the full filename ("<uid>.jpg"); bind it to the caller's own uid
    // + .jpg rather than treating the filename as the uid (which never matched).
    match /avatars/{file} {
      allow read: if true;
      allow write: if signedIn() && file == request.auth.uid + '.jpg' && okImage();
    }

    // Proof media (Phase 1). Path scoped to the uploading user.
    match /proofs/{eventId}/{uid}/{file} {
      allow read: if signedIn();
      // Content-validate uploads, but keep delete separate: a delete carries no
      // request.resource, so okImage()/okAudio() would reject it and leave the
      // blob orphaned when deleteProof() removes the doc. Owners delete their own
      // media; admins delete reported/flagged media during moderation.
      allow create, update: if isOwner(uid)
        && !eventClosedToPlay(eventId)
        && (okImage() || okAudio());
      allow delete: if isOwner(uid) || isEventAdmin(eventId);
    }

    // Private server-written bug-report evidence. The submitBugReport callable
    // uses the Admin SDK; no browser identity may read, enumerate, or mutate it.
    match /bug-reports/{uidHash}/{reportId}/{file} {
      allow read, write: if false;
    }
  }
}
