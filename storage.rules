rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // The Storage half of the post-Event freeze (#134,
    // specs/post-sailing-archive.md). `firestore.rules` denies the Proof
    // DOCUMENT on a closing or archived Event; this denies its MEDIA, because a
    // denial on only one of the two leaves an archive that still grows blobs —
    // the #806 lesson, and exactly what `specs/path-addressing-and-root.md` § D8
    // names ("Storage uploads under that Event's prefix alike").
    //
    // Both halves of the freeze deny here, exactly as they do in
    // `firestore.rules`: the CLOSING state (`archiving: true`) is the quiescing
    // phase the archive snapshot is taken during, so media that could still land
    // through it would be media the record never sees (Codex P1, PR #1139).
    //
    // At most two Firestore accesses, the per-evaluation Storage budget.
    // One Event fetch serves the freeze and admission; one membership fetch
    // is needed only for enforced non-Admins. Storage
    // Rules make no promise of deduplicating a repeated `firestore.get()` on the
    // same path, so a second inline read of the same document could spend the
    // budget and fail the write closed. The `'active'` / `false` defaults keep an
    // Event document carrying neither key OPEN.
    //
    // A MISSING Event document is CLOSED for proof media (see
    // `openAndAdmittedProofMedia` below): the Firestore half of a Proof already
    // requires the Event (`admitted()` reads it), so media under an Event id
    // that names no Event is media no Proof document can ever point at — and a
    // server-side scanner would otherwise spend work on it.
    //
    // Each arm is evaluated on its own, for its own method, so the budget is
    // spent per operation rather than shared across the two arms below.
    function closedToPlay(event) {
      return event.get('status', 'active') == 'archived'
        || event.get('archiving', false) == true;
    }

    // WHO MAY DELETE PROOF MEDIA. NOBODY, WHILE ITS PROOF DOCUMENT STANDS.
    //
    // EVERY client delete of a proof object requires the Proof document to be
    // already GONE — the owner's and the Admin's alike (#1153, Codex round 4 P2
    // for the owner, round 5 P2 for the rest). `proofDocMissing` is the
    // load-bearing condition and it gates the WHOLE arm; the identity check
    // after it only decides WHICH signed-in caller may clear the resulting
    // orphan.
    //
    // ROUND 4 CLOSED THIS FOR THE PLAIN OWNER AND LEFT IT OPEN FOR THE ADMIN.
    // The arm read `(isOwner(uid) && proofDocMissing(...)) || <is an admin>`, so
    // a media owner who is ALSO listed in the Event's `admins` — the ordinary
    // shape for an organiser playing their own Event — still passed the admin
    // branch while their Proof document stood, and the upload arm still let that
    // same identity recreate the emptied path as its owner, because `resource ==
    // null` refuses an overwrite and welcomes a RECREATE. That is precisely the
    // delete-and-recreate window round 4 was closing: a delete-then-reupload
    // landing between `proofMediaGeneration()`'s read and `deleteProof`'s commit
    // binds the media-revocation tombstone to the OLD blob while the path holds
    // the replacement; the inline delete fails, the sweeper's
    // `ifGenerationMatch` answers `412`, and it retires the row as a post-delete
    // replacement — leaving the deleted Proof's media reachable through its
    // download URL, which is the one outcome the tombstone exists to prevent.
    // Generation capture has to be serialised against EVERY identity that can
    // empty and refill the path, so the condition belongs on the arm rather than
    // inside one of its branches.
    //
    // NOTHING THE APP DOES NEEDS THE LIVE-PROOF DELETE, ON EITHER PATH. There
    // are exactly two client Storage deletes, both in `src/data/proofs.ts`, and
    // both run on media no Proof document points at:
    //   - `deleteProof` — which is the OWNER's delete AND the ADMIN takedown,
    //     one function for both — calls `deleteStoragePath` AFTER
    //     `await runTransaction(...)` has resolved, and that transaction's last
    //     write is `tx.delete(proofRef)`. The document is gone before the object
    //     delete is even issued. A takedown re-run after a committed delete
    //     finds no Proof either, and revokes inline exactly as it did before.
    //   - `attachProof`'s rollback deletes the object from the `.catch` on its
    //     own transaction, so that transaction was REFUSED and no Proof document
    //     was ever written for it.
    //
    // THE ADMIN TAKEDOWN IS THEREFORE UNTOUCHED IN PRACTICE, in every Event
    // state including the frozen one: it is an ORPHAN delete like every other,
    // and orphan deletes never close. That is what #808 asks for — a permanent
    // record that locks out its own Admin is that support incident in a new
    // place — and it is why the freeze is not consulted on this arm at all.
    //
    // THE IDENTITY CHECK STAYS, WHICH IS WHY THE EVENT `get()` STAYS. With
    // `proofDocMissing` carrying the safety, the only remaining question is who
    // may clear an orphan, and the answer is not "any signed-in caller": a
    // stranger deleting somebody else's orphaned media is still a denial. So the
    // branch is `isOwner(uid)` OR the Event's `admins` roster. `admins` is read
    // through `get('admins', [])` so an Event document missing the field denies
    // cleanly instead of erroring the evaluation, and `proofMediaDeleteOk` takes
    // the document's DATA as an ARGUMENT rather than fetching its own copy:
    // Storage Rules allow two Firestore accesses per evaluation and make no
    // promise of deduplicating a repeated `firestore.get()` on one path, so a
    // helper that read its own would spend three beside the `exists()` and fail
    // every legitimate delete closed. D10 retains this complete delete budget
    // (`specs/event-membership.md`): orphan cleanup does not add admission.
    //
    // `{file}` is `<proofId>.<ext>` — `uploadProofMedia` writes that shape and
    // only that shape (`src/data/storage.ts`), and `firestore.rules` pins the
    // Proof document's `storagePath` to it — so the Proof id is the basename.
    // Only the FINAL extension is stripped (Phase 4b P1 on PR #1157): Firestore
    // permits a Proof id that itself carries a dot (`p.q`, media `p.q.jpg`),
    // and a split on the first dot looked that up as `proofs/p` — absent, so
    // the orphan branch released media a surviving document still pointed at.
    // `replace('[.][^.]*$', '')` is an RE2 replace of the last dot and what
    // follows it, which is the extension `uploadProofMedia` appended.
    //
    // THE BUDGET, SPENT PRECISELY. Storage Rules allow two Firestore accesses
    // per evaluation, and this arm never exceeds them:
    //   - UNAUTHENTICATED: zero. `signedIn()` short-circuits ahead of both.
    //   - ANY signed-in caller against a LIVE Proof's object: one. The
    //     `exists()` answers no and the `get()` is never reached — which is the
    //     whole delete-and-recreate denial, plain owner, admin-owner, Admin and
    //     stranger alike.
    //   - THE PATH'S OWNER, orphan: one. `isOwner(uid)` reads the token and the
    //     path only, so the `||` short-circuits before the `get()`.
    //   - A NON-OWNER (an Admin, or a stranger), orphan: two — the `exists()`
    //     that answered yes, then the `get()` that asks whether they are an
    //     Admin of this Event, which is the one way that request can still be
    //     allowed.
    // That is the cap, not past it. (The Storage EMULATOR does not enforce the
    // cap at all: an arm making eighteen distinct accesses is admitted there.
    // Measured for #1153, Codex round 4 P2 — which is why the budget is
    // reasoned about here rather than asserted by a test.)
    //
    // A MISSING Event document DENIES the NON-OWNER orphan branch, because the
    // `get()` errors and an errored access is a denial. Conservative, and it
    // costs the app nothing: the OWNER's orphan delete never reads the Event at
    // all, so a legacy Event — or media under an Event document that was never
    // written — stays clearable by the party that uploaded it: a delete never
    // needs the Event to exist (an UPLOAD does — `openAndAdmittedProofMedia`). Media
    // whose Proof document exists under a missing Event document is denied one
    // step earlier still, by `proofDocMissing` itself.
    function proofMediaDeleteOk(event) {
      return signedIn() && request.auth.uid in event.get('admins', []);
    }
    function proofDocMissing(eventId, file) {
      return !firestore.exists(
        /databases/(default)/documents/events/$(eventId)/proofs/$(file.replace('[.][^.]*$', '')));
    }
    function mayDeleteProofMedia(eventId, uid, file) {
      return signedIn()
        && proofDocMissing(eventId, file)
        && (isOwner(uid)
          || proofMediaDeleteOk(
               firestore.get(/databases/(default)/documents/events/$(eventId)).data));
    }
    // Image uploads name their type exactly rather than `image/*`:
    // `image/svg+xml` is a document that can carry script, and a download URL
    // for one served from the Storage origin is not something any flow in this
    // app produces. Both image writers — `uploadAvatar` and `uploadProofMedia`
    // — re-encode through a canvas and upload `image/jpeg` under a `.jpg` name,
    // and both image arms below admit only a `.jpg` name, so a `.jpg` object
    // must BE `image/jpeg`. A future image arm that takes another extension
    // should allow-list raster types (`image/(jpeg|png|webp|heic)`), never
    // widen back to `image/*`.
    function okJpeg() {
      return request.resource.contentType == 'image/jpeg'
        && request.resource.size < 8 * 1024 * 1024;
    }
    // A proof object's name is `<proofId>.<ext>`: the Firestore auto-id
    // `attachProof` minted (alphanumeric; `firestore.rules` holds the Proof id
    // to the same `[A-Za-z0-9-]` shape) and the extension `uploadProofMedia`
    // chose for the media kind. No `_` and no second `.`, so a client cannot
    // plant a `{proofId}_thumb.jpg` beside the server-written thumbnail. The extension decides the content check, so a `.jpg` is a
    // JPEG and a `.webm` / `.m4a` is audio.
    function okProofMedia(file) {
      return (file.matches('^[A-Za-z0-9-]{1,40}[.]jpg$') && okJpeg())
        || (file.matches('^[A-Za-z0-9-]{1,40}[.](webm|m4a)$') && okAudio());
    }
    // Reads and creates spend ONE Event get, threaded through admission and
    // the upload freeze, plus at most ONE membership get. A missing Event
    // errors to deny. D-A precedes the membership lookup so a backfill-missed
    // Admin is admitted without touching a missing membership document.
    function admittedProofMedia(event, eventId) {
      return event.get('membershipEnforcement', 'off') != 'enforced'
        // TRANSITIONAL D-A: remove with the Firestore admission disjunct.
        || request.auth.uid in event.get('admins', [])
        || firestore.get(/databases/(default)/documents/events/$(eventId)/memberships/$(request.auth.uid))
             .data.status == 'active';
    }
    function openAndAdmittedProofMedia(event, eventId) {
      return !closedToPlay(event) && admittedProofMedia(event, eventId);
    }
    function okAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 12 * 1024 * 1024;
    }

    // Custom avatars. uploadAvatar() writes avatars/{uid}.jpg, so the wildcard
    // captures the full filename ("<uid>.jpg"); bind it to the caller's own uid
    // + .jpg rather than treating the filename as the uid (which never matched).
    match /avatars/{file} {
      allow read: if true;
      allow write: if signedIn() && file == request.auth.uid + '.jpg' && okJpeg();
    }

    // Proof media (Phase 1). Path scoped to the uploading user.
    // A missing Event now denies even absent/off reads. Proof publication
    // requires an Event; leftover orphan cleanup uses the separate delete arm.
    match /proofs/{eventId}/{uid}/{file} {
      allow read: if signedIn() && admittedProofMedia(
        firestore.get(/databases/(default)/documents/events/$(eventId)).data, eventId);
      // Content-validate uploads, but keep delete separate: a delete carries no
      // request.resource, so okJpeg()/okAudio() would reject it and leave the
      // blob orphaned when deleteProof() removes the doc. An ORPHANED object —
      // one no Proof document points at — is clearable in every state, and since
      // #1153 that is the ONLY client delete this arm admits: media a live Proof
      // document still points at is nobody's to remove, the OWNER's and the
      // ADMIN's alike, because either could otherwise empty the path and refill
      // it inside the generation-capture window. Admins still take reported or
      // flagged media down in every state including the frozen one — `deleteProof`
      // commits the Proof delete BEFORE it revokes the object, so the takedown is
      // an orphan delete like every other. See `mayDeleteProofMedia`.
      //
      // CREATE ONLY: A PROOF OBJECT IS IMMUTABLE (#1153, Codex round 3 P2). The
      // arm used to read `create, update`, so the owner — or another tab of
      // theirs — could OVERWRITE the canonical object in place. `deleteProof`
      // reads the object's Storage `generation` before its transaction opens and
      // records it on the tombstone; an overwrite landing in the window between
      // that read and the commit leaves the row bound to the PREVIOUS blob,
      // although the Proof pointed at the replacement when it was deleted. The
      // inline Storage delete then fails, the sweeper's `ifGenerationMatch`
      // answers `412`, and it retires the row as a post-delete replacement —
      // leaving the deleted Proof's own media reachable through its download
      // URL, which is exactly the outcome the tombstone exists to prevent.
      //
      // Immutability closes it at the source rather than teaching the sweeper to
      // tell an overwrite that PRECEDES its row from one that FOLLOWS it: with
      // no overwrite possible, a `412` can only mean the name was re-occupied
      // after a DELETE, which is the case retirement is already correct for.
      //
      // AND `resource == null` ALONE WAS NOT ENOUGH (#1153, Codex rounds 4 and
      // 5 P2). It refuses an overwrite and welcomes a recreate, so a caller who
      // could DELETE a live Proof's object could immediately upload a replacement
      // to the now-empty path — the same desynchronised tombstone by another
      // route. The half that closes it is on the DELETE arm, not here: NO client
      // may remove media while its Proof document stands, an admin-owner
      // included (see `mayDeleteProofMedia`), so within this window there is
      // nothing to recreate. This arm stays exactly as it is, because a Proof
      // id under a pending revocation cannot be brought back anyway —
      // `firestore.rules` refuses the Proof create while its
      // `proofStorageDeletes` row stands, and asking that question HERE would be
      // a third Firestore access this arm has no budget for
      // (`openAndAdmittedProofMedia` already spends both).
      //
      // `resource == null` IS THE PREDICATE, not an `allow create` without
      // `update`. The two are supposed to be equivalent — `create` is documented
      // as the new-object method and `update` as the existing-object one — and
      // they are not: the Storage emulator evaluates a second `uploadBytes` at
      // an occupied path under `create` and lets it through, so an arm that only
      // dropped `update` would deny nothing and no test could catch it. Asking
      // the state directly is both correct and provable, and it holds whichever
      // method a platform decides a wholesale object replacement is. `resource`
      // is the EXISTING object's metadata — null when there is none — so this
      // reads the bucket, not Firestore, and the two-access budget below is
      // untouched. The method list stays `create, update` so neither can slip
      // past the predicate.
      //
      // The app never wanted the overwrite. `attachProof` mints a fresh
      // Firestore auto-id per capture and `uploadProofMedia` names the object
      // after it, so every upload is a first write to a name nothing has used; a
      // refused transaction DELETES its object and the Player's retry re-uploads
      // under a NEW id. `src/data/storage.ts` has asserted this invariant since
      // #363. Object immutability does not imply cache safety: proof uploads
      // now use private/no-store (#1410), because visibility can change.
      // `avatars/{uid}.jpg` IS overwritten in place on a profile edit. That avatar arm is a separate `match` above and
      // keeps its full `write`.
      //
      // NOT a claim that nothing under this prefix is ever rewritten. The Vision
      // handler's thumbnail (`functions/src/index.ts`) saves
      // `{proofId}_thumb.jpg` on the Admin SDK, which bypasses these rules
      // entirely and can legitimately re-save on a redelivered Storage trigger.
      // What this arm governs is the browser.
      allow create, update: if isOwner(uid)
        && resource == null
        // These fields are authoritative server decisions, never upload input.
        && !request.resource.metadata.keys().hasAny([
          'faSrc', 'faHold', 'faLease'
        ])
        && okProofMedia(file)
        && openAndAdmittedProofMedia(
          firestore.get(/databases/(default)/documents/events/$(eventId)).data, eventId);
      // D10: orphan cleanup is exempt from admission. Proof-document deletion
      // is admission-gated in Firestore; this arm never removes live Proof
      // media and grants no read or create authority. Preserve its one/two
      // accesses (Proof exists + optional Event get to check whether any non-owner is on the Admin roster).
      allow delete: if mayDeleteProofMedia(eventId, uid, file);
    }

    // Private server-written bug-report evidence. The submitBugReport callable
    // uses the Admin SDK; no browser identity may read, enumerate, or mutate it.
    match /bug-reports/{uidHash}/{reportId}/{file} {
      allow read, write: if false;
    }
  }
}
