rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // The Storage half of the post-Event freeze (#134,
    // specs/post-sailing-archive.md). `firestore.rules` denies the Proof
    // DOCUMENT on a closing or archived Event; this denies its MEDIA, because a
    // denial on only one of the two leaves an archive that still grows blobs —
    // the #806 lesson, and exactly what `specs/path-addressing-and-root.md` § D8
    // names ("Storage uploads under that Event's prefix alike").
    //
    // Both halves of the freeze deny here, exactly as they do in
    // `firestore.rules`: the CLOSING state (`archiving: true`) is the quiescing
    // phase the archive snapshot is taken during, so media that could still land
    // through it would be media the record never sees (Codex P1, PR #1139).
    //
    // Two Firestore accesses, which is the whole per-evaluation budget Storage
    // Rules allow. Reading the document ONCE and passing its data to
    // `closedToPlay` is what keeps it at two: unlike `firestore.rules`, Storage
    // Rules make no promise of deduplicating a repeated `firestore.get()` on the
    // same path, so a second inline read of the same document could spend the
    // budget and fail the write closed. The `exists()` half is not decoration
    // either: without it a missing Event document would error the `get()` and
    // newly deny a write that succeeds today, and the `'active'` / `false`
    // defaults keep an Event document carrying neither key OPEN.
    //
    // Each arm is evaluated on its own, for its own method, so the budget is
    // spent per operation rather than shared across the two arms below.
    function closedToPlay(event) {
      return event.get('status', 'active') == 'archived'
        || event.get('archiving', false) == true;
    }
    function eventClosedToPlay(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        && closedToPlay(firestore.get(/databases/(default)/documents/events/$(eventId)).data);
    }

    // WHO MAY DELETE PROOF MEDIA, from ONE Event read (Phase 4b P1, PR #1157).
    // The owner's arm used to be unconditional, so a direct `deleteObject` still
    // stripped an archived Proof's media although `firestore.rules` refuses the
    // owner's DOCUMENT delete on a closed Event — leaving a Feed entry whose
    // image can never load, on the one Event where nothing can be re-posted. The
    // freeze therefore reaches the owner's media delete as well, on both halves
    // of it, exactly as it reaches the upload.
    //
    // THE ADMIN TAKEDOWN STAYS OPEN in every state, which is the whole point of
    // the asymmetry: a permanent record that locks out its own Admin is #808's
    // support incident in a new place. An Admin must be able to take a reported
    // photo down out of a frozen Event.
    //
    // ONE `get()`, ANSWERING BOTH QUESTIONS. Asking `isEventAdmin()` and then
    // `eventClosedToPlay()` would read the same document twice — three accesses
    // against a two-access budget — and Storage Rules make no promise of
    // deduplicating that, so every legitimate delete could fail closed. So the
    // document is fetched once, here, and `proofMediaDeleteOk` answers the admin
    // check and the closed check from the same map. `admins` is read through
    // `get('admins', [])` rather than `.admins` so an Event document missing the
    // field denies cleanly instead of erroring the evaluation.
    //
    // A MISSING Event document reads as OPEN, matching the upload arm and the
    // `firestore.rules` default: `exists()` is false, no `get()` is spent, and
    // the owner keeps the unconditional delete they have today. (#806 will thread
    // its membership check through this same fetch; it must drop the `exists()`
    // when it does, the way its own membership `get()` already relies on
    // error-to-deny — see `specs/event-membership.md` § "Storage has zero
    // headroom".)
    function proofMediaDeleteOk(event, uid) {
      return (signedIn() && request.auth.uid in event.get('admins', []))
        || (isOwner(uid) && !closedToPlay(event));
    }
    function mayDeleteProofMedia(eventId, uid) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        ? proofMediaDeleteOk(
            firestore.get(/databases/(default)/documents/events/$(eventId)).data, uid)
        : isOwner(uid);
    }
    function okImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }
    function okAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 12 * 1024 * 1024;
    }

    // Custom avatars. uploadAvatar() writes avatars/{uid}.jpg, so the wildcard
    // captures the full filename ("<uid>.jpg"); bind it to the caller's own uid
    // + .jpg rather than treating the filename as the uid (which never matched).
    match /avatars/{file} {
      allow read: if true;
      allow write: if signedIn() && file == request.auth.uid + '.jpg' && okImage();
    }

    // Proof media (Phase 1). Path scoped to the uploading user.
    match /proofs/{eventId}/{uid}/{file} {
      allow read: if signedIn();
      // Content-validate uploads, but keep delete separate: a delete carries no
      // request.resource, so okImage()/okAudio() would reject it and leave the
      // blob orphaned when deleteProof() removes the doc. Owners delete their own
      // media while the Event is open to play; admins delete reported/flagged
      // media during moderation, in every state including the frozen one.
      allow create, update: if isOwner(uid)
        && !eventClosedToPlay(eventId)
        && (okImage() || okAudio());
      allow delete: if mayDeleteProofMedia(eventId, uid);
    }

    // Private server-written bug-report evidence. The submitBugReport callable
    // uses the Admin SDK; no browser identity may read, enumerate, or mutate it.
    match /bug-reports/{uidHash}/{reportId}/{file} {
      allow read, write: if false;
    }
  }
}
