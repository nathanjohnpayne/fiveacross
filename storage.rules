rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // The Storage half of the post-Event freeze (#134,
    // specs/post-sailing-archive.md). `firestore.rules` denies the Proof
    // DOCUMENT on a closing or archived Event; this denies its MEDIA, because a
    // denial on only one of the two leaves an archive that still grows blobs —
    // the #806 lesson, and exactly what `specs/path-addressing-and-root.md` § D8
    // names ("Storage uploads under that Event's prefix alike").
    //
    // Both halves of the freeze deny here, exactly as they do in
    // `firestore.rules`: the CLOSING state (`archiving: true`) is the quiescing
    // phase the archive snapshot is taken during, so media that could still land
    // through it would be media the record never sees (Codex P1, PR #1139).
    //
    // Two Firestore accesses, which is the whole per-evaluation budget Storage
    // Rules allow. Reading the document ONCE and passing its data to
    // `closedToPlay` is what keeps it at two: unlike `firestore.rules`, Storage
    // Rules make no promise of deduplicating a repeated `firestore.get()` on the
    // same path, so a second inline read of the same document could spend the
    // budget and fail the write closed. The `exists()` half is not decoration
    // either: without it a missing Event document would error the `get()` and
    // newly deny a write that succeeds today, and the `'active'` / `false`
    // defaults keep an Event document carrying neither key OPEN.
    //
    // Each arm is evaluated on its own, for its own method, so the budget is
    // spent per operation rather than shared across the two arms below.
    function closedToPlay(event) {
      return event.get('status', 'active') == 'archived'
        || event.get('archiving', false) == true;
    }
    function eventClosedToPlay(eventId) {
      return firestore.exists(/databases/(default)/documents/events/$(eventId))
        && closedToPlay(firestore.get(/databases/(default)/documents/events/$(eventId)).data);
    }

    // WHO MAY DELETE PROOF MEDIA. TWO PARTIES, AND ONLY ONE OF THEM IS THE OWNER.
    //
    // The OWNER may delete a proof object only when its Proof document is
    // already GONE (#1153, Codex round 4 P2 — see `proofMediaDeleteOk` below for
    // why the live-Proof case had to close). That is the orphan carve-out, and
    // it is now the owner's whole permission rather than an addition to a
    // general one: media a live Proof still points at is never the owner's to
    // remove, in any Event state.
    //
    // THE ADMIN TAKEDOWN STAYS OPEN in every state, which is the whole point of
    // the asymmetry: a permanent record that locks out its own Admin is #808's
    // support incident in a new place. An Admin must be able to take a reported
    // photo down out of a frozen Event.
    //
    // THE EVENT IS STILL FETCHED ONCE, AND STILL PASSED IN. `proofMediaDeleteOk`
    // now answers only the admin check, but it keeps taking the document's data
    // as an ARGUMENT rather than reading it itself: Storage Rules allow two
    // Firestore accesses per evaluation and make no promise of deduplicating a
    // repeated `firestore.get()` on one path, so a helper that fetched its own
    // copy beside the `exists()` above would spend three and fail every
    // legitimate admin delete closed. That threading is also what #806 is
    // relying on (`specs/event-membership.md` § "Storage has zero headroom").
    // `admins` is read through `get('admins', [])` rather than `.admins` so an
    // Event document missing the field denies cleanly instead of erroring the
    // evaluation.
    //
    // THE ORPHAN BRANCH (Codex P1, PR #1157; now the owner's only branch). The
    // freeze exists to protect a Proof DOCUMENT's media: a Feed entry whose
    // image can never load is the harm, and it needs an entry to be the harm at
    // all. Media whose Proof document does NOT exist has no entry to strand — it
    // is a blob nothing points at — so the owner may always clear it, in every
    // state. That is not a loosening for its own sake: it is the only thing that
    // makes the two client paths recoverable across the quiesce. An `attachProof`
    // upload whose Proof/Board transaction is then denied by the freeze leaves
    // exactly such a blob, and `deleteProof` (which commits BEFORE revoking the media)
    // revokes exactly such a blob — inline, and again from the durable tombstone
    // its commit wrote (`events/{eventId}/proofStorageDeletes/{proofId}`, #1153)
    // when the inline attempt fails. Without the carve-out both are permanent
    // litter in the one Event nothing can be re-posted to. The tombstone's own
    // sweeper does not need it: `revokeDeletedProofMedia` runs on the Admin SDK,
    // which bypasses these rules entirely.
    //
    // `{file}` is `<proofId>.<ext>` — `uploadProofMedia` writes that shape and
    // only that shape (`src/data/storage.ts`), and `firestore.rules` pins the
    // Proof document's `storagePath` to it — so the Proof id is the basename.
    // Only the FINAL extension is stripped (Phase 4b P1 on PR #1157): Firestore
    // permits a Proof id that itself carries a dot (`p.q`, media `p.q.jpg`),
    // and a split on the first dot looked that up as `proofs/p` — absent, so
    // the orphan branch released media a surviving document still pointed at.
    // `replace('[.][^.]*$', '')` is an RE2 replace of the last dot and what
    // follows it, which is the extension `uploadProofMedia` appended.
    //
    // THE BUDGET, SPENT PRECISELY. Storage Rules allow two Firestore accesses
    // per evaluation. The orphan clause is FIRST and short-circuiting, so the
    // common paths cost one access each: an orphan delete spends the
    // `exists()` and stops; an admin takedown is not `isOwner`, skips the
    // `exists()` entirely, and spends the `get()`. Only an OWNER whose Proof
    // document is still there spends both — the `exists()` that answered no,
    // then the `get()` that asks whether they are an Admin of this Event, which
    // is the one way that request can still be allowed. That is the cap, not
    // past it. (The Storage EMULATOR does not enforce this cap at all: an arm
    // making eighteen distinct accesses is admitted there. Measured for #1153,
    // Codex round 4 P2 — which is why the budget is reasoned about here rather
    // than asserted by a test.)
    //
    // A MISSING Event document now DENIES the existing-Proof branch, because
    // the `exists()` that used to guard the `get()` is spent on the Proof
    // instead and the `get()` errors closed. That is reachable only for media
    // whose Proof document exists under an Event document that does not, and
    // denying is the conservative direction; the absence-means-open default the
    // upload arm carries is preserved for every path that has no Proof document,
    // which is what a legacy or orphaned path actually is. (#806 will thread its
    // membership check through the same fetch — see `specs/event-membership.md`
    // § "Storage has zero headroom".)
    //
    // AND THE OWNER'S ARM IS GONE FROM HERE ENTIRELY (#1153, Codex round 4 P2).
    // It used to read `|| (isOwner(uid) && !closedToPlay(event))`: the owner
    // could delete media a LIVE Proof document still points at, as long as the
    // Event was open. Immutability closed the overwrite half of the
    // generation-capture window and left that half open — an owner can DELETE the
    // object and immediately recreate the now-empty path, which `resource ==
    // null` welcomes, so a delete-and-recreate landing between
    // `proofMediaGeneration()`'s read and `deleteProof`'s commit binds the
    // tombstone to the OLD blob while the path holds the replacement. The inline
    // delete then fails, the sweeper's `ifGenerationMatch` answers `412`, and it
    // retires the row as a post-delete replacement, leaving the deleted Proof's
    // media reachable — the exact outcome the tombstone exists to prevent, and
    // the one immutability was supposed to have closed.
    //
    // So an owner may delete a proof object only once its Proof document is
    // GONE, which is the `proofDocMissing` branch in `mayDeleteProofMedia`
    // below. With the live-Proof delete refused there is no window to race: the
    // object cannot be removed while the document that names it stands, so it
    // cannot be recreated either, and a `412` can still only mean the name was
    // re-occupied after the Proof itself was deleted.
    //
    // NOTHING THE APP DOES NEEDS THE OLD ARM. Both client deletes run on media
    // no Proof document points at: `deleteProof` commits the document's removal
    // BEFORE it revokes the object (§ the tombstone), and `attachProof`'s
    // rollback deletes an object whose transaction was refused, so no document
    // was ever written. Each therefore passes through `proofDocMissing`.
    //
    // THE ADMIN TAKEDOWN IS UNTOUCHED, in every state, which is what this
    // function is now for: a permanent record that locks out its own Admin is
    // #808's support incident in a new place. The `uid` parameter goes with the
    // owner arm — the caller is checked against the Event's `admins` roster, not
    // against the path's owner segment.
    function proofMediaDeleteOk(event) {
      return signedIn() && request.auth.uid in event.get('admins', []);
    }
    function proofDocMissing(eventId, file) {
      return !firestore.exists(
        /databases/(default)/documents/events/$(eventId)/proofs/$(file.replace('[.][^.]*$', '')));
    }
    function mayDeleteProofMedia(eventId, uid, file) {
      return signedIn()
        && ((isOwner(uid) && proofDocMissing(eventId, file))
          || proofMediaDeleteOk(
               firestore.get(/databases/(default)/documents/events/$(eventId)).data));
    }
    function okImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }
    function okAudio() {
      return request.resource.contentType.matches('audio/.*')
        && request.resource.size < 12 * 1024 * 1024;
    }

    // Custom avatars. uploadAvatar() writes avatars/{uid}.jpg, so the wildcard
    // captures the full filename ("<uid>.jpg"); bind it to the caller's own uid
    // + .jpg rather than treating the filename as the uid (which never matched).
    match /avatars/{file} {
      allow read: if true;
      allow write: if signedIn() && file == request.auth.uid + '.jpg' && okImage();
    }

    // Proof media (Phase 1). Path scoped to the uploading user.
    match /proofs/{eventId}/{uid}/{file} {
      allow read: if signedIn();
      // Content-validate uploads, but keep delete separate: a delete carries no
      // request.resource, so okImage()/okAudio() would reject it and leave the
      // blob orphaned when deleteProof() removes the doc. An ORPHANED object —
      // one no Proof document points at — is its owner's to clear in every
      // state, and since #1153 that is the OWNER's only delete: media a live
      // Proof document still points at is never theirs to remove. Admins delete
      // reported/flagged media during moderation, in every state including the
      // frozen one. See `mayDeleteProofMedia`.
      //
      // CREATE ONLY: A PROOF OBJECT IS IMMUTABLE (#1153, Codex round 3 P2). The
      // arm used to read `create, update`, so the owner — or another tab of
      // theirs — could OVERWRITE the canonical object in place. `deleteProof`
      // reads the object's Storage `generation` before its transaction opens and
      // records it on the tombstone; an overwrite landing in the window between
      // that read and the commit leaves the row bound to the PREVIOUS blob,
      // although the Proof pointed at the replacement when it was deleted. The
      // inline Storage delete then fails, the sweeper's `ifGenerationMatch`
      // answers `412`, and it retires the row as a post-delete replacement —
      // leaving the deleted Proof's own media reachable through its download
      // URL, which is exactly the outcome the tombstone exists to prevent.
      //
      // Immutability closes it at the source rather than teaching the sweeper to
      // tell an overwrite that PRECEDES its row from one that FOLLOWS it: with
      // no overwrite possible, a `412` can only mean the name was re-occupied
      // after a DELETE, which is the case retirement is already correct for.
      //
      // AND `resource == null` ALONE WAS NOT ENOUGH (#1153, Codex round 4 P2).
      // It refuses an overwrite and welcomes a recreate, so an owner could
      // DELETE a live Proof's object and immediately upload a replacement to the
      // now-empty path — the same desynchronised tombstone by another route. The
      // half that closes it is on the DELETE arm, not here: an owner may no
      // longer remove media while its Proof document stands (see
      // `proofMediaDeleteOk`), so within this window there is nothing to
      // recreate. This arm stays exactly as it is, because a Proof id under a
      // pending revocation cannot be brought back anyway — `firestore.rules`
      // refuses the Proof create while its `proofStorageDeletes` row stands, and
      // asking that question HERE would be a third Firestore access this arm has
      // no budget for (`eventClosedToPlay` already spends both).
      //
      // `resource == null` IS THE PREDICATE, not an `allow create` without
      // `update`. The two are supposed to be equivalent — `create` is documented
      // as the new-object method and `update` as the existing-object one — and
      // they are not: the Storage emulator evaluates a second `uploadBytes` at
      // an occupied path under `create` and lets it through, so an arm that only
      // dropped `update` would deny nothing and no test could catch it. Asking
      // the state directly is both correct and provable, and it holds whichever
      // method a platform decides a wholesale object replacement is. `resource`
      // is the EXISTING object's metadata — null when there is none — so this
      // reads the bucket, not Firestore, and the two-access budget below is
      // untouched. The method list stays `create, update` so neither can slip
      // past the predicate.
      //
      // The app never wanted the overwrite. `attachProof` mints a fresh
      // Firestore auto-id per capture and `uploadProofMedia` names the object
      // after it, so every upload is a first write to a name nothing has used; a
      // refused transaction DELETES its object and the Player's retry re-uploads
      // under a NEW id. `src/data/storage.ts` has asserted this invariant since
      // #363 — it is why proof media is served `immutable` while
      // `avatars/{uid}.jpg`, which IS overwritten in place on a profile edit,
      // deliberately is not. That avatar arm is a separate `match` above and
      // keeps its full `write`.
      //
      // NOT a claim that nothing under this prefix is ever rewritten. The Vision
      // handler's thumbnail (`functions/src/index.ts`) saves
      // `{proofId}_thumb.jpg` on the Admin SDK, which bypasses these rules
      // entirely and can legitimately re-save on a redelivered Storage trigger.
      // What this arm governs is the browser.
      allow create, update: if isOwner(uid)
        && resource == null
        && !eventClosedToPlay(eventId)
        && (okImage() || okAudio());
      allow delete: if mayDeleteProofMedia(eventId, uid, file);
    }

    // Private server-written bug-report evidence. The submitBugReport callable
    // uses the Admin SDK; no browser identity may read, enumerate, or mutate it.
    match /bug-reports/{uidHash}/{reportId}/{file} {
      allow read, write: if false;
    }
  }
}
