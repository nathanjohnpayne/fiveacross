# Build artifacts — regenerate through build system
dist/
build/
.next/
.out/
*.tsbuildinfo

# Marketing screenshot output (docs/app/marketing-screenshots.md). Regenerated
# on demand by scripts/marketing-shots.sh; the PNGs are copied into whichever
# repo consumes them, never committed here. The rest of artifacts/ IS tracked,
# so this is scoped to the one generated subdirectory.
artifacts/marketing/

# Capture-bundle build output (its own outDir so a concurrent e2e build cannot
# clobber it, and vice versa).
dist-marketing/

# Environment and secrets
.env
.env.local
.env.*.local
# Named Firebase target environments are local operational config. The
# exception keeps the committed target template visible to new checkouts.
/.env.*
!/.env.example
# .env.tpl is the committed op:// template consumed by the (currently
# disabled) INJECT_FILES workflow in scripts/bootstrap-config.sh — keep this
# negation even though no .env.tpl exists yet, or a fresh checkout can't
# stage the template once that workflow is turned on.
!/.env.tpl
*.pem
*.key

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Editor
.vscode/
!.vscode/extensions.json
.idea/

# AI / agents (local state and runtime artifacts only)
# Shared config (settings.json, .cursor/rules/, etc.) remains committed
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.cursor/cache/
.cursor/state/
.cursor/plans/
# Codex feedback verdict ledger (#487) — runtime operational state written
# by scripts/codex-record-feedback.sh; read by the rollup / pr-audit, never
# committed.
.mergepath/
.github/bug-reports/inbox/
.github/bug-reports/imported/
.github/bug-reports/.tmp-*/

# Testing
coverage/
playwright-report/
test-results/

# Firebase
.firebase/
firebase-adminsdk*.json
# Seed fallback service-account key (scripts/seed.mjs) — never commit
serviceAccountKey.json

# Misc
tmp/
.cache/

# Local Functions secret stubs (scripts/test-e2e.sh creates and cleans its own;
# a pre-existing one is user-owned and must never be committed).
functions/.secret.local

# Cloudflare Worker local dev secrets (worker/README.md § 2 rehearsal). Holds a
# real Firebase web api key; never committed.
.dev.vars
worker/.dev.vars
